# Конфигурация базы данных PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/telegram_bots_tickets

# JWT секретные ключи (сгенерируйте случайные строки минимум 32 символа)
# Для генерации: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_random_secret_key_for_access_token_here_min_32_chars
JWT_REFRESH_SECRET=your_random_secret_key_for_refresh_token_here_min_32_chars

# Порт сервера
PORT=3000

# URL frontend (для CORS)
# Для продакшена используйте домен вашего фронтенда
# Можно указать несколько доменов через запятую, но в этом примере показан основной
FRONTEND_URL=https://telegram-bots.pl

# URL для ссылок в уведомлениях
# Используйте домен вашего фронтенда
APP_URL=https://telegram-bots.pl

# Публичный URL backend (для формирования OAuth redirect URI)
BACKEND_URL=http://localhost:3000

# ── OAuth: Discord ──────────────────────────────────────────────
# https://discord.com/developers/applications → New Application → OAuth2
# Redirect URI: {BACKEND_URL}/api/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Необязательно (по умолчанию строится из BACKEND_URL):
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/oauth/discord/callback

# ── OAuth: Google ───────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials → Create OAuth client ID (Web application)
# Authorized redirect URI: {BACKEND_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# ── OAuth: GitHub ───────────────────────────────────────────────
# https://github.com/settings/developers → New OAuth App
# Authorization callback URL: {BACKEND_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/oauth/github/callback